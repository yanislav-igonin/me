---
import Heading from "../components/Heading.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Yanislav Igonin">
	<div class="flex flex-1 flex-col justify-center items-center">
		<div class="mb-4 text-center">
			<Heading text="What's up guys?" />
		</div>

		<div id="eblo" class="w-60 h-60 md:w-72 md:h-72 relative cursor-pointer select-none">
			<img
				src="/eblo.webp"
				alt="site owner's face"
				width="512"
				height="512"
				loading="eager"
				class="absolute inset-0 h-full w-full"
			/>
		</div>
	</div>
</Layout>

<script>
	const eblo = document.getElementById("eblo");
	eblo?.addEventListener("click", () => {
		eblo.classList.remove("spin-decay");
		// force reflow so the animation restarts on every click
		void eblo.offsetWidth;
		eblo.classList.add("spin-decay");
	});
</script>
