		"format": "biome format --write .",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.1"
	}
}
