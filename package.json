{
	"name": "me",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome check --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true --css-parse-tailwind-directives=true .",
