{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	// Biome parses .astro frontmatter but does not yet track template usage,
	// so frontmatter imports and Astro.props destructures look "unused".
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
